# sway config for hosting quickgreet under greetd.
#
#   /etc/greetd/config.toml:
#     command = "sway --config /etc/greetd/sway-greeter.config"
#     user = "greeter"
#
# Lighter than Hyprland and perfectly good here. Use it if you don't already
# run Hyprland, or want the greeter's compositor kept separate from it.

# Outputs. `swaymsg -t get_outputs` lists names; copy your real layout in.
#   output NAME resolution WxH@RATEHz position X,Y scale N
output * bg #000000 solid_color
# Example, dual 4K side by side:
# output DP-3 resolution 3840x2160@60Hz position 0,0 scale 1
# output DP-2 resolution 3840x2160@60Hz position 3840,0 scale 1

# Match your session's keymap — otherwise you're typing your password blind on
# the wrong layout.
input * {
    xkb_layout us
    xkb_numlock enabled
}

default_border none
hide_edge_borders both

# Run the greeter, and exit sway as soon as it's done. The `; swaymsg exit`
# is what tears the compositor down after a successful launch.
exec "qs -p /usr/share/quickgreet/greeter.qml; swaymsg exit"

# An escape hatch if the greeter ever fails to draw.
bindsym Ctrl+Alt+Delete exit
